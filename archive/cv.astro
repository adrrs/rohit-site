---
// src/pages/cv.astro
import Base from '../layouts/Base.astro';
---
<Base title="CV">

  <h1>CV</h1>
  <p class="section-intro">
    Abbreviated. Full CV available on request —
    <a href="mailto:rohit@sonika.me" style="color: var(--accent);">email me</a>.
  </p>

  <div class="cv-section">
    <h3>Positions</h3>

     <div class="cv-entry">
      <div class="cv-years">2026–</div>
      <div>
        <div class="cv-role">Saara and Björn Wahlroos Foundation Fellow</div>
        <div class="cv-org">Hanken School of Economics, Helsinki</div>
      </div>
    </div>
    
    <div class="cv-entry">
      <div class="cv-years">2024–</div>
      <div>
        <div class="cv-role">Associate Researcher</div>
        <div class="cv-org">Hanken School of Economics, Helsinki</div>
      </div>
    </div>

    <div class="cv-entry">
      <div class="cv-years">2017–2018</div>
      <div>
        <div class="cv-role">Visiting Researcher</div>
        <div class="cv-org">Aalto University &amp; Hanken School of Economics</div>
      </div>
    </div>

    <div class="cv-entry">
      <div class="cv-years">2014–2017</div>
      <div>
        <div class="cv-role">Assistant Professor</div>
        <div class="cv-org">University of Exeter, UK</div>
      </div>
    </div>
  
    <div class="cv-entry" style="border-bottom: none;">
      <div class="cv-years">2019-2024</div>
      <div>
        <div class="cv-role">Big Four Consulting</div>
        <div class="cv-org">PwC · EY · KPMG</div>
      </div>
    </div>
  </div>

  <div class="cv-section">
    <h3>Education</h3>

    <div class="cv-entry">
      <div class="cv-years">2009–2014</div>
      <div>
        <div class="cv-role">PhD, Accounting and Finance</div>
        <div class="cv-org">Lancaster University Management School</div>
        <div class="cv-note">Supervised by M. Shackleton, S. Banerjee, N. Carline</div>
      </div>
    </div>

    <div class="cv-entry" style="border-bottom: none;">
      <div class="cv-years">2005-2006</div>
      <div>
        <div class="cv-role">MSc Finance and Investment</div>
        <div class="cv-org">University of Edinburgh</div>
      </div>
    </div>
  </div>

  <div class="cv-section">
    <h3>Teaching</h3>

    <div class="cv-entry">
      <div class="cv-years">Exeter</div>
      <div>
        <div class="cv-role">Corporate Finance · Financial Econometrics</div>
        <div class="cv-org">Evaluation scores 3.89–4.51 / 5.0</div>
      </div>
    </div>

    <div class="cv-entry">
      <div class="cv-years">Aalto</div>
      <div>
        <div class="cv-role">Advanced Corporate Finance / Private Equity</div>
        <div class="cv-org">Visiting lecturer</div>
      </div>
    </div>

    <div class="cv-entry">
      <div class="cv-years">Lancaster</div>
      <div>
        <div class="cv-role">Undergraduate Finance modules</div>
        <div class="cv-org">Teaching assistant</div>
      </div>
    </div>
  </div>

  <div class="cv-section">
    <h3>Skills &amp; Tools</h3>
    <div style="margin-top: 8px;">
      <span class="tag">R</span>
      <span class="tag">Stata</span>
      <span class="tag">Tableau</span>
      <span class="tag">PowerBI</span>
      <span class="tag accent">Causal Inference</span>
      <span class="tag accent">Panel Data</span>
      <span class="tag accent">Diff-in-Diff</span>
    </div>
  </div>

</Base>

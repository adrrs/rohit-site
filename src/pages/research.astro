<script>
function toggleAbstract(id, btn) {
  const el = document.getElementById(id);
  if (el.style.display === 'block') {
    el.style.display = 'none';
    btn.textContent = '+ abstract';
  } else {
    el.style.display = 'block';
    btn.textContent = '− abstract';
  }
}
</script>

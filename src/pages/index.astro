---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('thoughts');
const recentPosts = allPosts
  .filter((p: { data: { draft?: boolean } }) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---
<Base title="Rohit Sonika">

  <h1>Hey, I'm Rohit.</h1>
  <p class="lede">Finance researcher, data strategist, and occasional writer based in Helsinki.</p>

  <p>
    I study corporate finance — how corporate and legislative governance dictate corporate 
    decision-making. I work as the Saara and Björn Wahlroos Foundation Fellow
    at <strong>Hanken School of Economics</strong>.
  </p>

  <div class="hero-links">
    <a href="/research" class="btn btn-primary">Research</a>
    <a href="/about" class="btn btn-ghost">About me</a>
    <a href="mailto:rohit@sonika.me" class="btn btn-ghost">Email</a>
  </div>

  <h2>Recent Thoughts</h2>

  {recentPosts.map(post => (
    <a href={`/thoughts/${post.slug}`} class="thought-item">
      <div class="thought-date">
        {post.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
      </div>
      <div class="thought-title">{post.data.title}</div>
      {post.data.excerpt && (
        <div class="thought-excerpt">{post.data.excerpt}</div>
      )}
      <div class="read-more">Read →</div>
    </a>
  ))}

  <h2>Research Interests</h2>

  <div class="interests-grid">
    <div class="interest-card">
      <strong>Payout Policy</strong>
      Buybacks, dividends, and what firms signal through capital returns
    </div>
    <div class="interest-card">
      <strong>Executive Compensation</strong>
      Option grants, FAS 123R, rent extraction vs optimal contracting
    </div>
    <div class="interest-card">
      <strong>Insider Trading</strong>
      CEO networks, information asymmetry, and market timing
    </div>
    <div class="interest-card">
      <strong>Board Governance</strong>
      Independence, related-party transactions, monitoring quality
    </div>
  </div>

  <h2>Selected Publications</h2>

  <div class="pub-item">
    <a class="pub-title" href="https://doi.org/10.1016/j.jbankfin.2024.107288" target="_blank">
      The timing of stock repurchases: Do well-connected CEOs help or harm?
    </a>
    <div class="pub-authors">with Amedeo D. Cesari, Nicoletta Marinelli</div>
    <div class="pub-journal">
      Journal of Banking &amp; Finance, 2024, 168:107288
      <span class="journal-badge">JBF</span>
    </div>
  </div>

  <div class="pub-item">
    <a class="pub-title" href="https://dx.doi.org/10.1016/j.jbankfin.2020.105800" target="_blank">
      Buyback behaviour and the option funding hypothesis
    </a>
    <div class="pub-authors">with Mark B. Shackleton</div>
    <div class="pub-journal">
      Journal of Banking &amp; Finance, 2020, 114:105800
      <span class="journal-badge">JBF</span>
    </div>
  </div>

  <p style="margin-top: 16px;">
    <a href="/research" style="font-family: var(--font-mono); font-size: 12px; color: var(--accent);">
      View all publications →
    </a>
  </p>

</Base>
